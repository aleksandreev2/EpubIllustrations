{
  "name": "novelpia-illustrations",
  "version": "1.0.0",
  "private": true,
  "description": "Иллюстрации из EPUB по главам — в папку или ZIP, без пережатия",
  "author": { "name": "dollar · Дом Некроманта", "url": "https://ranobelib.me/ru/user/726236" },
  "license": "MIT",
  "homepage": "https://github.com/aleksandreev2/EpubIllustrations",
  "repository": { "type": "git", "url": "https://github.com/aleksandreev2/EpubIllustrations.git" },
  "bugs": { "url": "https://github.com/aleksandreev2/EpubIllustrations/issues" },
  "engines": { "node": ">=22.4" },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "demo": "node scripts/create-demo.cjs",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "dist": "electron-builder --win nsis portable",
    "checksums": "node scripts/checksums.cjs"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "local.novelpia.illustrations",
    "productName": "Иллюстрации EPUB",
    "asar": true,
    "files": ["src/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis", "portable"], "icon": "src/assets/icon.ico"},
    "nsis": {"artifactName": "EpubIllustrations-${version}-Setup.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Иллюстрации EPUB"},
    "portable": {"artifactName": "EpubIllustrations-${version}-Portable.${ext}"},
    "publish": {"provider": "github", "owner": "aleksandreev2", "repo": "EpubIllustrations"}
  }
}
